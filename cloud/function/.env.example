APPWRITE_ENDPOINT=https://YOUR-REGION.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=YOUR_APPWRITE_PROJECT_ID
APPWRITE_DATABASE_ID=kindred
# APPWRITE_SETUP_KEY is used only by setup.mjs and moderate.mjs, never in Flutter or the Function runtime.
APPWRITE_SETUP_KEY=YOUR_TEMPORARY_SETUP_KEY
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_BUCKET=kindred-private-photos
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
